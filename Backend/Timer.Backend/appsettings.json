{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "TimerBackend": {
    "InitializeSchema": false,
    "AllowReadRepair": false,
    "EnableOutboxWorker": false,
    "Runtime": {
      "RequestTimeoutSeconds": 15,
      "WorkerShutdownTimeoutSeconds": 15,
      "WorkerMaxLagSeconds": 300
    },
    "WriteApi": {
      "Enabled": false
    },
    "Database": {
      "Type": "postgresql",
      "ConnectionString": ""
    }
  }
}
