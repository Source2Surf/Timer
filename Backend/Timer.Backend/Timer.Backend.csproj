<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Timer.Backend</AssemblyName>
    <RootNamespace>Timer.Backend</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Timer.RequestManager/Timer.Shared still expose ModSharp types in their public metadata.
         Keep the runtime dependency explicit until the SQL read store is extracted completely. -->
    <PackageReference Include="ModSharp.Sharp.Shared" Version="2.1.136" />
    <PackageReference Include="MagicOnion.Server" Version="7.11.0" />
    <ProjectReference Include="..\Timer.Backend.Contracts\Timer.Backend.Contracts.csproj" />
    <ProjectReference Include="..\Timer.Backend.Rpc.Contracts\Timer.Backend.Rpc.Contracts.csproj" />
    <ProjectReference Include="..\..\Plugin\Timer.RequestManager\Timer.RequestManager.csproj" />
    <ProjectReference Include="..\..\Plugin\Timer.Shared\Timer.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Timer.Backend.Tests" />
  </ItemGroup>

</Project>
