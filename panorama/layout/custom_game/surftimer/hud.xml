<root>
	<styles>
		<include src="file://{resources}/styles/custom_game/surftimer/hud.css" />
		<include src="file://{resources}/styles/custom_game/surftimer/hud_positions.css" />
	</styles>

	<!--
		Surf timer HUD, driven by the Timer plugin (Plugin/Timer/Modules/HudModule.cs). Every player has their own
		custom_hud_layout entity running this layout, networked only to them, so everything is set on the entity
		as a whole: SetDialogVariableString("<id>", "<var>", value) on the element that owns the {s:var}.
		Every class the plugin switches sits on the element it styles: the engine doesn't restyle children when a
		class changes on their parent. The classes written here only show until the plugin's first update: it sets
		every class it uses once on a new entity.
		Fixed labels have an id and {s:text}, which the plugin sets to the player's text (HudLabels in HudText.cs),
		so they read in the player's language.
		Draggable panels (Menu, RunPanel, CSpeedPanel, InfoPanel, SplitsPanel, KeysPanel, LocsPanel) get placed / editing /
		dragging / smooth, and once placed are centre-aligned and offset with mx-N / my-N on the panel plus
		fx-N / fy-N on their full-screen *Pos wrapper (timer_positions.css).
	-->
	<!-- The root panel may not have an id, so TimerRoot is an inner wrapper (hidden for spectators). -->
	<Panel class="Root" hittest="false">
		<Panel id="TimerRoot" class="Timer" hittest="false">

			<!-- Timer: one layout per state (start zone, running, finished, stopped). The script shows the lines and
			     spacers each state needs; the defaults here are the start-zone layout. The heading lines are fixed;
			     below them, Line0..Line7 are slots the script fills in the player's chosen order (Zone, a blank
			     line, Mode, Speed, Start / end speed, Sync, Jumps, Strafes by default). -->
			<Panel id="RunPos" class="DragPos" hittest="false">
				<Button id="RunPanel" class="RunPanel">
					<Panel id="RunBody" class="PanelBody">
						<Label id="Title" class="Title Hidden" text="{s:title}" />
						<Panel id="GapTitle" class="Spacer Hidden" />
						<Label id="Time" class="Time Hidden" text="{s:time}" />
						<Label id="TimeCmp" class="Cmp Hidden" text="({s:cmp})" />
						<Panel id="GapTime" class="Spacer Hidden" />
						<Label id="StageFinish" class="Hidden" text="{s:text}" />
						<Label id="StageCmp" class="Cmp Hidden" text="({s:cmp})" />
						<Panel id="GapStage" class="Spacer Hidden" />
						<Label id="Line0" class="Line" text="{s:text}" />
						<Label id="Line1" class="Line gap" text="{s:text}" />
						<Label id="Line2" class="Line" text="{s:text}" />
						<Label id="Line3" class="Line" text="{s:text}" />
						<Label id="Line4" class="Line Hidden" text="{s:text}" />
						<Label id="Line5" class="Line" text="{s:text}" />
						<Label id="Line6" class="Line Hidden" text="{s:text}" />
						<Label id="Line7" class="Line Hidden" text="{s:text}" />
					</Panel>
				</Button>
			</Panel>

			<!-- Center speed: just the number, under the crosshair -->
			<Panel id="CSpeedPos" class="DragPos" hittest="false">
				<Button id="CSpeedPanel" class="CSpeedPanel">
					<Panel id="CSpeedBody" class="PanelBody">
						<Label id="CSpeed" class="CSpeed" text="{s:speed}" />
					</Panel>
				</Button>
			</Panel>

			<!-- Records: server record and your PB, top-left corner -->
			<Panel id="InfoPos" class="DragPos" hittest="false">
				<Button id="InfoPanel" class="InfoPanel">
					<Panel id="InfoBody" class="PanelBody">
						<Label id="Sr" text="{s:sr}" />
						<Label id="Pb" text="{s:pb}" />
					</Panel>
				</Button>
			</Panel>

			<!-- Splits: newest on top in fixed slots; the fade is per slot, so it never needs sending.
			     SplitsBody gets shift-a / shift-b and Split0 enter-a / enter-b when a split arrives. -->
			<Panel id="SplitsPos" class="DragPos" hittest="false">
				<Button id="SplitsPanel" class="SplitsPanel">
					<Panel id="SplitsBody" class="PanelBody SplitsBody">
						<Label id="SplitsEmpty" class="SplitsEmpty" text="{s:text}" />
						<Panel id="Split0" class="SplitRow Hidden">
							<Label id="Split0Name" class="SplitName" text="{s:name}" />
							<Label id="Split0Time" class="SplitTime" text="{s:time}" />
							<Label id="Split0Diff" class="SplitDiff" text="{s:diff}" />
						</Panel>
						<Panel id="Split1" class="SplitRow Fade1 Hidden">
							<Label id="Split1Name" class="SplitName" text="{s:name}" />
							<Label id="Split1Time" class="SplitTime" text="{s:time}" />
							<Label id="Split1Diff" class="SplitDiff" text="{s:diff}" />
						</Panel>
						<Panel id="Split2" class="SplitRow Fade2 Hidden">
							<Label id="Split2Name" class="SplitName" text="{s:name}" />
							<Label id="Split2Time" class="SplitTime" text="{s:time}" />
							<Label id="Split2Diff" class="SplitDiff" text="{s:diff}" />
						</Panel>
						<Panel id="Split3" class="SplitRow Fade3 Hidden">
							<Label id="Split3Name" class="SplitName" text="{s:name}" />
							<Label id="Split3Time" class="SplitTime" text="{s:time}" />
							<Label id="Split3Diff" class="SplitDiff" text="{s:diff}" />
						</Panel>
						<Panel id="Split4" class="SplitRow Fade4 Hidden">
							<Label id="Split4Name" class="SplitName" text="{s:name}" />
							<Label id="Split4Time" class="SplitTime" text="{s:time}" />
							<Label id="Split4Diff" class="SplitDiff" text="{s:diff}" />
						</Panel>
						<Panel id="Split5" class="SplitRow Fade4 Hidden">
							<Label id="Split5Name" class="SplitName" text="{s:name}" />
							<Label id="Split5Time" class="SplitTime" text="{s:time}" />
							<Label id="Split5Diff" class="SplitDiff" text="{s:diff}" />
						</Panel>
						<Panel id="Split6" class="SplitRow Fade4 Hidden">
							<Label id="Split6Name" class="SplitName" text="{s:name}" />
							<Label id="Split6Time" class="SplitTime" text="{s:time}" />
							<Label id="Split6Diff" class="SplitDiff" text="{s:diff}" />
						</Panel>
						<Panel id="Split7" class="SplitRow Fade4 Hidden">
							<Label id="Split7Name" class="SplitName" text="{s:name}" />
							<Label id="Split7Time" class="SplitTime" text="{s:time}" />
							<Label id="Split7Diff" class="SplitDiff" text="{s:diff}" />
						</Panel>
					</Panel>
				</Button>
			</Panel>

			<!-- Keys (!showkeys): off by default; caps get "on" while held, the arrows while turning -->
			<Panel id="KeysPos" class="DragPos" hittest="false">
				<Button id="KeysPanel" class="KeysPanel Hidden">
					<Panel id="KeysBody" class="PanelBody KeysBody">
						<Panel class="KeyRow">
							<Label id="KeyW" class="Cap" text="W" />
						</Panel>
						<Panel class="KeyRow">
							<Label id="KeyLeft" class="Cap Arrow" text="◀" />
							<Label id="KeyA" class="Cap" text="A" />
							<Label id="KeyS" class="Cap" text="S" />
							<Label id="KeyD" class="Cap" text="D" />
							<Label id="KeyRight" class="Cap Arrow" text="▶" />
						</Panel>
						<Panel class="KeyRow">
							<Label id="KeyDuck" class="Cap Wide" text="{s:text}" />
							<Panel id="KeyGap" class="KeyGap" />
							<Label id="KeyJump" class="Cap Wide" text="{s:text}" />
						</Panel>
					</Panel>
				</Button>
			</Panel>

			<!-- Saved locations (practice): the actions with the keys the player bound to them. Each cap's editkey names a
			     command ("%saveloc%") and {g:csgo_key:editkey} shows its key, or NOT BOUND; the game's {s:bind_<command>}
			     stays empty in a custom HUD. The key is only looked up again when the label's text changes, so the plugin
			     changes the invisible {s:nonce} each time the panel shows, to pick up a key bound since. Walk + inspect shows and hides it; it also shows while the menu is open, to
			     drag it. -->
			<Panel id="LocsPos" class="DragPos" hittest="false">
				<Button id="LocsPanel" class="LocsPanel Hidden">
					<Panel id="LocsBody" class="PanelBody LocsBody">
						<Label id="LocsTitle" class="LocsTitle" text="{s:text}" />
						<Panel class="LocsRow"><Label id="LocsKeySave" class="LocsCap" text="{g:csgo_key:editkey}{s:nonce}" /><Label id="LocsSave" class="LocsAct" text="{s:text}" /></Panel>
						<Panel class="LocsRow"><Label id="LocsKeyTele" class="LocsCap" text="{g:csgo_key:editkey}{s:nonce}" /><Label id="LocsTele" class="LocsAct" text="{s:text}" /></Panel>
						<Panel class="LocsRow"><Label id="LocsKeyPrev" class="LocsCap" text="{g:csgo_key:editkey}{s:nonce}" /><Label id="LocsPrev" class="LocsAct" text="{s:text}" /></Panel>
						<Panel class="LocsRow"><Label id="LocsKeyNext" class="LocsCap" text="{g:csgo_key:editkey}{s:nonce}" /><Label id="LocsNext" class="LocsAct" text="{s:text}" /></Panel>
						<Panel class="LocsRow"><Label id="LocsKeyHide" class="LocsCap" text="{g:csgo_key:editkey} + {g:csgo_key:editkey2}{s:nonce}" /><Label id="LocsHide" class="LocsAct" text="{s:text}" /></Panel>
						<Label id="LocsNote" class="LocsNote" text="{s:text}" />
					</Panel>
				</Button>
			</Panel>
		</Panel>

		<!-- Centre guides, shown while a dragged panel is snapped to the screen's centre line. -->
		<Panel id="GuideX" class="Guide GuideX" hittest="false" />
		<Panel id="GuideY" class="Guide GuideY" hittest="false" />

		<!-- Key hint while dragging, at the top of the screen. It fades with opacity rather than switching
		     visibility, so its children never depend on a per-player class on their parent.
		     editkey holds a command like %attack%; csgo_key shows the key the player bound to it. -->
		<Panel id="DragToast" class="DragToast" hittest="false">
			<Label id="DragToastWhat" class="ToastWhat" text="{s:target}" />
			<Panel class="ToastPair">
				<Label id="MoveKeyPlace" class="Kbd" text="{g:csgo_key:editkey}" />
				<Label id="LToastPlace" class="ToastAction" text="{s:text}" />
			</Panel>
			<Panel class="ToastPair">
				<Label id="MoveKeyCancel" class="Kbd" text="{g:csgo_key:editkey}" />
				<Label id="LToastCancel" class="ToastAction" text="{s:text}" />
			</Panel>
			<Panel class="ToastPair">
				<Label id="MoveKeyReset" class="Kbd" text="{g:csgo_key:editkey}" />
				<Label id="LToastReset" class="ToastAction" text="{s:text}" />
			</Panel>
			<Panel class="ToastPair">
				<Label id="MoveKeyFree" class="Kbd" text="{g:csgo_key:editkey}" />
				<Label id="LToastFree" class="ToastAction" text="{s:text}" />
			</Panel>
		</Panel>

		<!-- HUD settings, opened with !hud. Option rows are Buttons whose id is an option in HudOptions.cs and whose
		     <id>Value label shows it; size steppers are <id>Down / <id>Up. -->
		<Panel id="MenuPos" class="DragPos" hittest="false">
			<Panel id="Menu" class="Menu Closed">
				<Button id="MenuMove" class="MenuHeader">
					<Label id="LMenuTitle" class="MenuTitle" text="{s:text}" />
					<Label id="LMenuGrip" class="MenuGrip" text="{s:text}" />
				</Button>

				<Panel class="MenuTabs">
					<Button id="TabHud" class="MenuTab active"><Label id="TabHudLabel" class="MenuTabLabel active" text="{s:text}" /></Button>
					<Button id="TabTimer" class="MenuTab"><Label id="TabTimerLabel" class="MenuTabLabel" text="{s:text}" /></Button>
					<Button id="TabSpeed" class="MenuTab"><Label id="TabSpeedLabel" class="MenuTabLabel" text="{s:text}" /></Button>
					<Button id="TabSplits" class="MenuTab"><Label id="TabSplitsLabel" class="MenuTabLabel" text="{s:text}" /></Button>
					<Button id="TabKeys" class="MenuTab"><Label id="TabKeysLabel" class="MenuTabLabel" text="{s:text}" /></Button>
				</Panel>

				<Panel class="MenuPages">
					<!-- HUD: every panel with its size and on/off -->
					<Panel id="PageHud" class="MenuPage">
						<Panel class="MenuSection"><Label id="LPanels" class="MenuSectionLabel" text="{s:text}" /><Panel class="MenuRule" /></Panel>
						<Panel class="MenuRow static">
							<Label id="LPanelRun" class="MenuName" text="{s:text}" />
							<Panel class="Stepper">
								<Button id="SizeRunDown" class="Step"><Label text="−" /></Button>
								<Label id="SizeRunValue" class="MenuValue" text="{s:value}" />
								<Button id="SizeRunUp" class="Step"><Label text="+" /></Button>
							</Panel>
							<Button id="OptRun" class="PillButton"><Label id="OptRunValue" class="MenuValue on" text="{s:value}" /></Button>
						</Panel>
						<Panel class="MenuRow static">
							<Label id="LPanelCSpeed" class="MenuName" text="{s:text}" />
							<Panel class="Stepper">
								<Button id="SizeCSpeedDown" class="Step"><Label text="−" /></Button>
								<Label id="SizeCSpeedValue" class="MenuValue" text="{s:value}" />
								<Button id="SizeCSpeedUp" class="Step"><Label text="+" /></Button>
							</Panel>
							<Button id="OptCSpeed" class="PillButton"><Label id="OptCSpeedValue" class="MenuValue on" text="{s:value}" /></Button>
						</Panel>
						<Panel class="MenuRow static tall">
							<Panel class="MenuText"><Label id="LPanelInfo" class="MenuName" text="{s:text}" /><Label id="LPanelInfoDesc" class="MenuDesc" text="{s:text}" /></Panel>
							<Panel class="Stepper">
								<Button id="SizeInfoDown" class="Step"><Label text="−" /></Button>
								<Label id="SizeInfoValue" class="MenuValue" text="{s:value}" />
								<Button id="SizeInfoUp" class="Step"><Label text="+" /></Button>
							</Panel>
							<Button id="OptInfo" class="PillButton"><Label id="OptInfoValue" class="MenuValue on" text="{s:value}" /></Button>
						</Panel>
						<Panel class="MenuRow static">
							<Label id="LPanelSplits" class="MenuName" text="{s:text}" />
							<Panel class="Stepper">
								<Button id="SizeSplitsDown" class="Step"><Label text="−" /></Button>
								<Label id="SizeSplitsValue" class="MenuValue" text="{s:value}" />
								<Button id="SizeSplitsUp" class="Step"><Label text="+" /></Button>
							</Panel>
							<Button id="OptSplits" class="PillButton"><Label id="OptSplitsValue" class="MenuValue on" text="{s:value}" /></Button>
						</Panel>
						<Panel class="MenuRow static tall">
							<Panel class="MenuText"><Label id="LPanelKeys" class="MenuName" text="{s:text}" /><Label id="LPanelKeysDesc" class="MenuDesc" text="{s:text}" /></Panel>
							<Panel class="Stepper">
								<Button id="SizeKeysDown" class="Step"><Label text="−" /></Button>
								<Label id="SizeKeysValue" class="MenuValue" text="{s:value}" />
								<Button id="SizeKeysUp" class="Step"><Label text="+" /></Button>
							</Panel>
							<Button id="OptKeys" class="PillButton"><Label id="OptKeysValue" class="MenuValue off" text="{s:value}" /></Button>
						</Panel>
					</Panel>

					<!-- Timer: lines and comparison -->
					<Panel id="PageTimer" class="MenuPage Hidden">
						<!-- Lines top to bottom: row i edits the item in slot i. Row0Up and Row7Down never apply. -->
						<Panel class="MenuSection"><Label id="LLines" class="MenuSectionLabel" text="{s:text}" /><Panel class="MenuRule" /></Panel>
						<Panel class="MenuRow static">
							<Label id="Row0Name" class="MenuName" text="{s:name}" />
							<Panel class="RowSteps">
								<Button id="Row0Up" class="Step disabled"><Label text="▲" /></Button>
								<Button id="Row0Down" class="Step"><Label text="▼" /></Button>
							</Panel>
							<Button id="Row0Toggle" class="PillButton"><Label id="Row0Value" class="MenuValue on" text="{s:value}" /></Button>
						</Panel>
						<Panel class="MenuRow static">
							<Label id="Row1Name" class="MenuName blank" text="{s:name}" />
							<Panel class="RowSteps">
								<Button id="Row1Up" class="Step"><Label text="▲" /></Button>
								<Button id="Row1Down" class="Step"><Label text="▼" /></Button>
							</Panel>
							<Button id="Row1Toggle" class="PillButton blank"><Label id="Row1Value" class="MenuValue" text="{s:value}" /></Button>
						</Panel>
						<Panel class="MenuRow static">
							<Label id="Row2Name" class="MenuName" text="{s:name}" />
							<Panel class="RowSteps">
								<Button id="Row2Up" class="Step"><Label text="▲" /></Button>
								<Button id="Row2Down" class="Step"><Label text="▼" /></Button>
							</Panel>
							<Button id="Row2Toggle" class="PillButton"><Label id="Row2Value" class="MenuValue on" text="{s:value}" /></Button>
						</Panel>
						<Panel class="MenuRow static">
							<Label id="Row3Name" class="MenuName" text="{s:name}" />
							<Panel class="RowSteps">
								<Button id="Row3Up" class="Step"><Label text="▲" /></Button>
								<Button id="Row3Down" class="Step"><Label text="▼" /></Button>
							</Panel>
							<Button id="Row3Toggle" class="PillButton"><Label id="Row3Value" class="MenuValue on" text="{s:value}" /></Button>
						</Panel>
						<Panel class="MenuRow static">
							<Label id="Row4Name" class="MenuName" text="{s:name}" />
							<Panel class="RowSteps">
								<Button id="Row4Up" class="Step"><Label text="▲" /></Button>
								<Button id="Row4Down" class="Step"><Label text="▼" /></Button>
							</Panel>
							<Button id="Row4Toggle" class="PillButton"><Label id="Row4Value" class="MenuValue on" text="{s:value}" /></Button>
						</Panel>
						<Panel class="MenuRow static">
							<Label id="Row5Name" class="MenuName" text="{s:name}" />
							<Panel class="RowSteps">
								<Button id="Row5Up" class="Step"><Label text="▲" /></Button>
								<Button id="Row5Down" class="Step"><Label text="▼" /></Button>
							</Panel>
							<Button id="Row5Toggle" class="PillButton"><Label id="Row5Value" class="MenuValue on" text="{s:value}" /></Button>
						</Panel>
						<Panel class="MenuRow static">
							<Label id="Row6Name" class="MenuName" text="{s:name}" />
							<Panel class="RowSteps">
								<Button id="Row6Up" class="Step"><Label text="▲" /></Button>
								<Button id="Row6Down" class="Step"><Label text="▼" /></Button>
							</Panel>
							<Button id="Row6Toggle" class="PillButton"><Label id="Row6Value" class="MenuValue off" text="{s:value}" /></Button>
						</Panel>
						<Panel class="MenuRow static">
							<Label id="Row7Name" class="MenuName" text="{s:name}" />
							<Panel class="RowSteps">
								<Button id="Row7Up" class="Step"><Label text="▲" /></Button>
								<Button id="Row7Down" class="Step disabled"><Label text="▼" /></Button>
							</Panel>
							<Button id="Row7Toggle" class="PillButton"><Label id="Row7Value" class="MenuValue off" text="{s:value}" /></Button>
						</Panel>
						<Panel class="MenuSection"><Label id="LComparison" class="MenuSectionLabel" text="{s:text}" /><Panel class="MenuRule" /></Panel>
						<Button id="OptCompare" class="MenuRow"><Label id="LCompare" class="MenuName" text="{s:text}" /><Label id="OptCompareValue" class="MenuValue" text="{s:value}" /></Button>
						<Button id="OptLive" class="MenuRow tall disabled">
							<Panel class="MenuText"><Label id="LLive" class="MenuName" text="{s:text}" /><Label id="LLiveDesc" class="MenuDesc" text="{s:text}" /></Panel>
							<Label id="OptLiveValue" class="MenuValue off" text="{s:value}" />
						</Button>
					</Panel>

					<!-- Speed: shared by the timer's speed line and center speed -->
					<Panel id="PageSpeed" class="MenuPage Hidden">
						<Panel class="MenuSection"><Label id="LSpeedSection" class="MenuSectionLabel" text="{s:text}" /><Panel class="MenuRule" /></Panel>
						<Button id="OptSpeedColor" class="MenuRow tall">
							<Panel class="MenuText"><Label id="LSpeedColor" class="MenuName" text="{s:text}" /><Label id="LSpeedColorDesc" class="MenuDesc" text="{s:text}" /></Panel>
							<Label id="OptSpeedColorValue" class="MenuValue on" text="{s:value}" />
						</Button>
						<Button id="OptSpeedAxes" class="MenuRow tall">
							<Panel class="MenuText"><Label id="LSpeedAxes" class="MenuName" text="{s:text}" /><Label id="LSpeedAxesDesc" class="MenuDesc" text="{s:text}" /></Panel>
							<Label id="OptSpeedAxesValue" class="MenuValue" text="{s:value}" />
						</Button>
					</Panel>

					<!-- Splits -->
					<Panel id="PageSplits" class="MenuPage Hidden">
						<Panel class="MenuSection"><Label id="LSplitsShow" class="MenuSectionLabel" text="{s:text}" /><Panel class="MenuRule" /></Panel>
						<Button id="OptSplitRows" class="MenuRow"><Label id="LSplitRows" class="MenuName" text="{s:text}" /><Label id="OptSplitRowsValue" class="MenuValue" text="{s:value}" /></Button>
						<Button id="OptSplitFade" class="MenuRow"><Label id="LSplitFade" class="MenuName" text="{s:text}" /><Label id="OptSplitFadeValue" class="MenuValue on" text="{s:value}" /></Button>
						<Label id="LSplitTip" class="MenuTip" text="{s:text}" />
					</Panel>

					<!-- Keys -->
					<Panel id="PageKeys" class="MenuPage Hidden">
						<Panel class="MenuSection"><Label id="LKeysShow" class="MenuSectionLabel" text="{s:text}" /><Panel class="MenuRule" /></Panel>
						<Button id="OptKeyMouse" class="MenuRow tall">
							<Panel class="MenuText"><Label id="LKeyMouse" class="MenuName" text="{s:text}" /><Label id="LKeyMouseDesc" class="MenuDesc" text="{s:text}" /></Panel>
							<Label id="OptKeyMouseValue" class="MenuValue on" text="{s:value}" />
						</Button>
						<Button id="OptKeyJumpDuck" class="MenuRow"><Label id="LKeyJumpDuck" class="MenuName" text="{s:text}" /><Label id="OptKeyJumpDuckValue" class="MenuValue on" text="{s:value}" /></Button>
					</Panel>
				</Panel>

				<Panel class="MenuFooter">
					<Button id="MenuReset" class="MenuButton">
						<Label id="LMenuReset" text="{s:text}" />
					</Button>
					<Button id="MenuClose" class="MenuButton MenuButton--primary">
						<Label id="LMenuClose" text="{s:text}" />
					</Button>
				</Panel>
			</Panel>
		</Panel>

		<!-- Replay menu, opened with !replay or E while spectating the central replay bot (HudReplayMenu.cs). Not
		     inside TimerRoot, so it shows while spectating. The list has 8 fixed rows; a row past the end of the
		     leaderboard is "blank" (kept, so the list doesn't change height). -->
		<Panel id="RMenu" class="Menu RMenu Closed">
			<Panel class="MenuHeader RMenuHeader">
				<Label id="LRmTitle" class="MenuTitle" text="{s:text}" />
			</Panel>

			<Panel class="MenuRow static">
				<Label id="LRmTrack" class="MenuName" text="{s:text}" />
				<Panel class="Stepper RmStepper">
					<Button id="RmTrackPrev" class="Step"><Label text="‹" /></Button>
					<Label id="RmTrackValue" class="MenuValue RmValue" text="{s:value}" />
					<Button id="RmTrackNext" class="Step"><Label text="›" /></Button>
				</Panel>
			</Panel>
			<Panel class="MenuRow static">
				<Label id="LRmStage" class="MenuName" text="{s:text}" />
				<Panel class="Stepper RmStepper">
					<Button id="RmStagePrev" class="Step"><Label text="‹" /></Button>
					<Label id="RmStageValue" class="MenuValue RmValue" text="{s:value}" />
					<Button id="RmStageNext" class="Step"><Label text="›" /></Button>
				</Panel>
			</Panel>
			<Panel class="MenuRow static">
				<Label id="LRmStyle" class="MenuName" text="{s:text}" />
				<Panel class="Stepper RmStepper">
					<Button id="RmStylePrev" class="Step"><Label text="‹" /></Button>
					<Label id="RmStyleValue" class="MenuValue RmValue" text="{s:value}" />
					<Button id="RmStyleNext" class="Step"><Label text="›" /></Button>
				</Panel>
			</Panel>

			<!-- The leaderboard, or the player's own recent runs (slower ones included). -->
			<Panel class="MenuTabs RmTabs">
				<Button id="RmTabBoard" class="MenuTab active"><Label id="RmTabBoardLabel" class="MenuTabLabel active" text="{s:text}" /></Button>
				<Button id="RmTabRuns" class="MenuTab"><Label id="RmTabRunsLabel" class="MenuTabLabel" text="{s:text}" /></Button>
			</Panel>

			<!-- The count, then (on the leaderboard) shortcuts that pick the WR or the player's own time and turn to its page. -->
			<Panel class="MenuSection">
				<Label id="RmCount" class="MenuSectionLabel" text="{s:text}" />
				<Panel class="MenuRule" />
				<Button id="RmJumpWr" class="RmJump"><Label id="LRmJumpWr" text="{s:text}" /></Button>
				<Button id="RmJumpPb" class="RmJump"><Label id="LRmJumpPb" text="{s:text}" /></Button>
			</Panel>

			<!-- Rows and the empty-list message share the space: children of a panel without a flow overlap. -->
			<Panel class="RmList">
				<Panel class="RmRows">
					<Button id="RmRow0" class="RmRow blank">
						<Label id="RmRow0Rank" class="RmRank" text="{s:text}" />
						<Label id="RmRow0Name" class="RmName" text="{s:text}" />
						<Label id="RmRow0Time" class="RmTime" text="{s:text}" />
						<Label id="RmRow0Gap" class="RmGap" text="{s:text}" />
					</Button>
					<Button id="RmRow1" class="RmRow blank">
						<Label id="RmRow1Rank" class="RmRank" text="{s:text}" />
						<Label id="RmRow1Name" class="RmName" text="{s:text}" />
						<Label id="RmRow1Time" class="RmTime" text="{s:text}" />
						<Label id="RmRow1Gap" class="RmGap" text="{s:text}" />
					</Button>
					<Button id="RmRow2" class="RmRow blank">
						<Label id="RmRow2Rank" class="RmRank" text="{s:text}" />
						<Label id="RmRow2Name" class="RmName" text="{s:text}" />
						<Label id="RmRow2Time" class="RmTime" text="{s:text}" />
						<Label id="RmRow2Gap" class="RmGap" text="{s:text}" />
					</Button>
					<Button id="RmRow3" class="RmRow blank">
						<Label id="RmRow3Rank" class="RmRank" text="{s:text}" />
						<Label id="RmRow3Name" class="RmName" text="{s:text}" />
						<Label id="RmRow3Time" class="RmTime" text="{s:text}" />
						<Label id="RmRow3Gap" class="RmGap" text="{s:text}" />
					</Button>
					<Button id="RmRow4" class="RmRow blank">
						<Label id="RmRow4Rank" class="RmRank" text="{s:text}" />
						<Label id="RmRow4Name" class="RmName" text="{s:text}" />
						<Label id="RmRow4Time" class="RmTime" text="{s:text}" />
						<Label id="RmRow4Gap" class="RmGap" text="{s:text}" />
					</Button>
					<Button id="RmRow5" class="RmRow blank">
						<Label id="RmRow5Rank" class="RmRank" text="{s:text}" />
						<Label id="RmRow5Name" class="RmName" text="{s:text}" />
						<Label id="RmRow5Time" class="RmTime" text="{s:text}" />
						<Label id="RmRow5Gap" class="RmGap" text="{s:text}" />
					</Button>
					<Button id="RmRow6" class="RmRow blank">
						<Label id="RmRow6Rank" class="RmRank" text="{s:text}" />
						<Label id="RmRow6Name" class="RmName" text="{s:text}" />
						<Label id="RmRow6Time" class="RmTime" text="{s:text}" />
						<Label id="RmRow6Gap" class="RmGap" text="{s:text}" />
					</Button>
					<Button id="RmRow7" class="RmRow blank">
						<Label id="RmRow7Rank" class="RmRank" text="{s:text}" />
						<Label id="RmRow7Name" class="RmName" text="{s:text}" />
						<Label id="RmRow7Time" class="RmTime" text="{s:text}" />
						<Label id="RmRow7Gap" class="RmGap" text="{s:text}" />
					</Button>
				</Panel>
				<Label id="RmEmpty" class="RmEmpty Hidden" text="{s:text}" />
			</Panel>

			<Panel class="RmPager">
				<Button id="RmPagePrev" class="Step"><Label text="‹" /></Button>
				<Label id="RmPage" class="RmPage" text="{s:text}" />
				<Button id="RmPageNext" class="Step"><Label text="›" /></Button>
			</Panel>

			<!-- A hint or why a Watch didn't start; or, watching the central bot, what's playing and its controls. -->
			<Panel class="RmArea">
				<Label id="RmStatus" class="RmStatus" text="{s:text}" />
				<Panel id="RmNow" class="RmNow Hidden">
					<Panel class="RmNowTop">
						<Label id="RmNowName" class="RmNowName" text="{s:text}" />
						<Label id="RmNowTag" class="RmNowTag" text="{s:text}" />
						<Label id="RmNowTime" class="RmNowTime" text="{s:text}" />
					</Panel>
					<Panel class="RmBar"><Panel id="RmBarFill" class="RmBarFill" /></Panel>
					<Panel id="RmCtl" class="RmCtl">
						<Button id="RmBack" class="RmButton"><Label text="−5s" /></Button>
						<Button id="RmPause" class="RmButton RmButtonWide"><Label id="RmPauseLabel" class="RmButtonLabel" text="{s:text}" /></Button>
						<Button id="RmFwd" class="RmButton"><Label text="+5s" /></Button>
						<Button id="RmSpeed" class="RmButton"><Label id="RmSpeedLabel" class="RmButtonLabel" text="{s:text}" /></Button>
						<Button id="RmStop" class="RmButton RmStop"><Label id="LRmStop" class="RmStopLabel" text="{s:text}" /></Button>
					</Panel>
					<Panel id="RmAlong" class="RmAlong Hidden">
						<Label id="RmAlongText" class="RmAlongText" text="{s:text}" />
						<Button id="RmLeave" class="RmButton RmLeave"><Label id="LRmLeave" text="{s:text}" /></Button>
					</Panel>
				</Panel>
			</Panel>

			<Panel class="MenuFooter">
				<Button id="RmClose" class="MenuButton RmClose">
					<Label id="LRmClose" text="{s:text}" />
				</Button>
				<Button id="RmWatch" class="MenuButton MenuButton--primary RmWatch">
					<Label id="RmWatchLabel" class="RmWatchLabel" text="{s:text}" />
				</Button>
			</Panel>
		</Panel>

		<!-- Profile card, opened with !profile (yours) or !profile name (HudProfileCard.cs): overall results for one
		     style, then this map's for that style and a track. Stage tiles past the map's stages are Hidden. -->
		<Panel id="PfMenu" class="Menu PfMenu Closed">
			<Panel class="MenuHeader RMenuHeader">
				<Label id="LPfTitle" class="MenuTitle" text="{s:text}" />
			</Panel>

			<Label id="PfName" class="PfName" text="{s:text}" />
			<Label id="PfRank" class="PfSub" text="{s:text}" />
			<Label id="PfJoined" class="PfSub" text="{s:text}" />

			<Panel class="MenuRow static">
				<Label id="LPfStyle" class="MenuName" text="{s:text}" />
				<Panel class="Stepper RmStepper">
					<Button id="PfStylePrev" class="Step"><Label text="‹" /></Button>
					<Label id="PfStyleValue" class="MenuValue RmValue" text="{s:value}" />
					<Button id="PfStyleNext" class="Step"><Label text="›" /></Button>
				</Panel>
			</Panel>

			<!-- Hidden when the request provider can't tell (GetPlayerSummary answers null). -->
			<Panel id="PfOverall" class="PfSection">
				<Panel class="MenuSection"><Label id="PfOverallTitle" class="MenuSectionLabel" text="{s:text}" /><Panel class="MenuRule" /></Panel>
				<Panel class="PfRow">
					<Label id="LPfMaps" class="PfLabel" text="{s:text}" />
					<Label id="PfMaps" class="PfValue" text="{s:text}" />
					<Label id="PfMapsOf" class="PfSmall" text="{s:text}" />
				</Panel>
				<Panel class="PfRow">
					<Label id="LPfBonuses" class="PfLabel" text="{s:text}" />
					<Label id="PfBonuses" class="PfValue" text="{s:text}" />
					<Label id="PfBonusesOf" class="PfSmall" text="{s:text}" />
				</Panel>
				<Panel class="PfRow">
					<Label id="LPfRecords" class="PfLabel" text="{s:text}" />
					<Label id="PfRecords" class="PfValue" text="{s:text}" />
				</Panel>
			</Panel>

			<Panel class="MenuSection"><Label id="LPfThisMap" class="MenuSectionLabel" text="{s:text}" /><Panel class="MenuRule" /></Panel>
			<Panel class="PfSection">
				<Panel class="PfRow">
					<Label id="LPfHere" class="PfLabel" text="{s:text}" />
					<Label id="PfHere" class="PfValue" text="{s:text}" />
					<Label id="PfPlays" class="PfSmall" text="{s:text}" />
				</Panel>
			</Panel>
			<Panel class="MenuRow static">
				<Label id="LPfTrack" class="MenuName" text="{s:text}" />
				<Panel class="Stepper RmStepper">
					<Button id="PfTrackPrev" class="Step"><Label text="‹" /></Button>
					<Label id="PfTrackValue" class="MenuValue RmValue" text="{s:value}" />
					<Button id="PfTrackNext" class="Step"><Label text="›" /></Button>
				</Panel>
			</Panel>
			<Panel class="PfSection">
				<Panel class="PfRow">
					<Label id="LPfPb" class="PfLabel" text="{s:text}" />
					<Label id="PfPb" class="PfValue" text="{s:text}" />
					<Label id="PfPbRank" class="PfSmall" text="{s:text}" />
				</Panel>
			</Panel>
			<Panel id="PfStages" class="PfStages">
				<Panel id="PfStage0" class="PfStage Hidden">
					<Label id="PfStage0Name" class="PfStageName" text="{s:text}" />
					<Label id="PfStage0Time" class="PfStageTime" text="{s:text}" />
				</Panel>
				<Panel id="PfStage1" class="PfStage Hidden">
					<Label id="PfStage1Name" class="PfStageName" text="{s:text}" />
					<Label id="PfStage1Time" class="PfStageTime" text="{s:text}" />
				</Panel>
				<Panel id="PfStage2" class="PfStage Hidden">
					<Label id="PfStage2Name" class="PfStageName" text="{s:text}" />
					<Label id="PfStage2Time" class="PfStageTime" text="{s:text}" />
				</Panel>
				<Panel id="PfStage3" class="PfStage Hidden">
					<Label id="PfStage3Name" class="PfStageName" text="{s:text}" />
					<Label id="PfStage3Time" class="PfStageTime" text="{s:text}" />
				</Panel>
				<Panel id="PfStage4" class="PfStage Hidden">
					<Label id="PfStage4Name" class="PfStageName" text="{s:text}" />
					<Label id="PfStage4Time" class="PfStageTime" text="{s:text}" />
				</Panel>
				<Panel id="PfStage5" class="PfStage Hidden">
					<Label id="PfStage5Name" class="PfStageName" text="{s:text}" />
					<Label id="PfStage5Time" class="PfStageTime" text="{s:text}" />
				</Panel>
				<Panel id="PfStage6" class="PfStage Hidden">
					<Label id="PfStage6Name" class="PfStageName" text="{s:text}" />
					<Label id="PfStage6Time" class="PfStageTime" text="{s:text}" />
				</Panel>
				<Panel id="PfStage7" class="PfStage Hidden">
					<Label id="PfStage7Name" class="PfStageName" text="{s:text}" />
					<Label id="PfStage7Time" class="PfStageTime" text="{s:text}" />
				</Panel>
				<Panel id="PfStage8" class="PfStage Hidden">
					<Label id="PfStage8Name" class="PfStageName" text="{s:text}" />
					<Label id="PfStage8Time" class="PfStageTime" text="{s:text}" />
				</Panel>
				<Panel id="PfStage9" class="PfStage Hidden">
					<Label id="PfStage9Name" class="PfStageName" text="{s:text}" />
					<Label id="PfStage9Time" class="PfStageTime" text="{s:text}" />
				</Panel>
				<Panel id="PfStage10" class="PfStage Hidden">
					<Label id="PfStage10Name" class="PfStageName" text="{s:text}" />
					<Label id="PfStage10Time" class="PfStageTime" text="{s:text}" />
				</Panel>
				<Panel id="PfStage11" class="PfStage Hidden">
					<Label id="PfStage11Name" class="PfStageName" text="{s:text}" />
					<Label id="PfStage11Time" class="PfStageTime" text="{s:text}" />
				</Panel>
			</Panel>

			<Panel class="MenuFooter">
				<Button id="PfClose" class="MenuButton MenuButton--primary PfClose">
					<Label id="LPfClose" text="{s:text}" />
				</Button>
			</Panel>
		</Panel>
	</Panel>
</root>
