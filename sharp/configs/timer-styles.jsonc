[
    // Style list used by the Timer plugin.
    // Add one object per style.
    {
        // Display name shown to players.
        "name": "Normal",

        // Chat commands (aliases) separated by ';'.
        "command": "normal;n",

        // Shown by !style; {colour} chat tags work.
        "description": "Auto bunnyhop, all keys.",

        // Runs and replays are stored under the id (0-63), so keep it when reordering or removing styles.
        // Without one, a style's id is its place in this list.
        "id": 0,

        // false = players can't pick it and it's left out of the menus; its runs are kept.
        "enabled": true,

        // Movement behavior.
        "autobhop": true,// equivalent to sv_autobunnyhopping
        "allow_bunnyhopping": true, // equivalent to sv_enablebunnyhopping

        // Air accelerate override.
        // false = use map/game-mode default airaccelerate.
        "custom_airaccelerate": false,
        // Used only when custom_airaccelerate is true.
        "airaccelerate": 150,

        // Pre-speed (start-zone exit speed) override.
        // false = use map/game-mode default pre-speed limit.
        "custom_prespeed": false,
        // Used only when custom_prespeed is true.
        "prespeed": 375,

        // Start-zone jump limit override, under a map's max_jumps.
        // false = use map/game-mode default.
        "custom_prejumps": false,
        // Used only when custom_prejumps is true. -1 = no limit, 0 = no jumping in the start zone.
        "prejumps": 1,

        // Base movement cvars replicated to player.
        "runspeed": 260,
        "accelerate": 5,
        "friction": 4,
        // Omit wishspeed to use the game mode's (timer-gamemodes.jsonc).
        // "wishspeed": 30,

        // Score multiplier for this style.
        // 1.0 = normal scoring, 0 = excluded from scoring.
        "score_factor": 1.0,

        // Optional movement key restrictions.
        "block_w": false,
        "block_s": false,
        "block_a": false,
        "block_d": false
    },
    {
        "name": "Sideways",
        "command": "sideways;sw",
        "description": "Only W and S.",
        "id": 1,
        "autobhop": true,
        "allow_bunnyhopping": true,
        "custom_airaccelerate": false,
        "airaccelerate": 150,
        "custom_prespeed": false,
        "prespeed": 375,
        "runspeed": 260,
        "accelerate": 5,
        "friction": 4,
        "score_factor": 1.0,

        // Sideways style: block A/D keys.
        "block_w": false,
        "block_s": false,
        "block_a": true,
        "block_d": true
    }
]
