{
  // Timer.Backend owns the database: every record, zone and map read or write goes through it.
  "backend": {
    // Its gRPC port, e.g. "http://127.0.0.1:5082". The backend serves it with TimerBackend:WriteApi:Enabled=true.
    "endpoint": ""
  },
  // Leave empty / omit the whole "replay" section to disable remote replay upload.
  // See README.md → "Replay Storage" for the HTTP contract your endpoint must implement.
  "replay": {
    // replace storage_base_url to your storage endpoint
    "storage_base_url": ""
  }
}
